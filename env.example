# Copy this file to env.local, replace every REPLACE_WITH_* value, then run:  source env.local
# Only acquisition/ (re-reading the confidential source documents) uses these variables;
# `bash reproduce.sh` needs none of them.  All paths are chosen by the reproducer.

# Folder holding the source problem sheets FE-0004.pdf ... FE-0047.pdf (not distributed)
export AEGIS_SRC=REPLACE_WITH_FOLDER_WITH_SOURCE_PDFS

# Writable scratch folder: renders, crops, reads.csv, vlm.csv, tokens_b.csv
export AEGIS_WORK=REPLACE_WITH_SCRATCH_FOLDER

# Folder where EasyOCR keeps (or will download) its models
export AEGIS_EASYOCR=REPLACE_WITH_EASYOCR_MODEL_FOLDER

# SmolVLM-256M-Instruct: a local snapshot folder, or leave the hub name to download it
export AEGIS_VLM=HuggingFaceTB/SmolVLM-256M-Instruct

# Optional: recognised text of the 344-token second set (contains document wording; never commit)
# export AEGIS_LOCAL_B=REPLACE_WITH_PATH_TO_reads_b.csv
